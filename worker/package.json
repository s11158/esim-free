{
  "name": "esim-free-payments-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types ./src/worker-configuration.d.ts",
    "types:check": "wrangler types --check ./src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run types:check && npm run typecheck && npm test && wrangler deploy --dry-run",
    "dev": "wrangler dev --local --test-scheduled",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply esim-free-orders --local",
    "db:migrate:remote": "wrangler d1 migrations apply esim-free-orders --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  }
}
