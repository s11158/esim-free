{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esim-free-payments",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://esim.free",
    "CATALOG_URL": "https://esim.free/data/catalog.csv",
    "PAYMENT_WALLET_ADDRESS": "TLwjVQ39DfxSsTRgnuvqBGRuRipZopZogs",
    "PAYMENT_WINDOW_MINUTES": "60",
    "TRONGRID_BASE_URL": "https://api.trongrid.io",
    "USDT_TRC20_CONTRACT": "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t",
    "ESIMERGE_BASE_URL": "https://portal.esimerge.com/api/public/v1"
  },
  "secrets": {
    "required": ["ORDER_HMAC_SECRET", "ESIMERGE_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "esim-free-orders",
      "database_id": "5a89e15e-1ea5-4488-9385-35673988a4b4",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
